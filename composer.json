{
    "name": "ismailnakkar/laravel-wordpress-posts",
    "description": "Draw a random published post from a WordPress database, cached, outage-tolerant and reduced to safe formatting HTML, in Laravel.",
    "keywords": [
        "laravel",
        "wordpress",
        "blog",
        "posts",
        "sanitize"
    ],
    "homepage": "https://github.com/ismailnakkar/laravel-wordpress-posts",
    "license": "MIT",
    "authors": [
        {
            "name": "Ismail Nakkar",
            "email": "juge.steam@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "laravel/framework": "^12.1 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.19",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "WordPressPosts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WordPressPosts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "check": [
            "vendor/bin/pint --test",
            "vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "WordPressPosts\\WordPressPostsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
